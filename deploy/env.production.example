# SME Business AI — production environment template (Plesk + Laravel Toolkit).
# Copy to the application's .env (mode 0600, owned by the subscription user).
# Never commit real values. Fill every <...>.

APP_NAME="SME Business AI"
APP_ENV=production
APP_KEY=<php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://<hostname>
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL on the same server (the server runs 13.x: no newer-only features).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=<database>
DB_USERNAME=<user>
DB_PASSWORD=<secret>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log

# Real visitor IPs for rate limits when behind Cloudflare: comma-separated
# proxy IPs/CIDRs (the official Cloudflare ranges). Never "*". Read by
# config/business.php.
TRUSTED_PROXIES=

# AI Business Assistant provider (HTTPS required in production; base URL without /v1).
# Budgets live in config/assistant.php.
LOCAL_LLM_BASE_URL=https://<provider-host>
LOCAL_LLM_API_KEY=<secret>
LOCAL_LLM_MODEL=<model-alias>
ASSISTANT_REASONING_EFFORT=none

# Optional narrator voice (text to speech through OpenRouter); leave empty to keep the assistant silent.
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=
OPENROUTER_TTS_VOICE=
